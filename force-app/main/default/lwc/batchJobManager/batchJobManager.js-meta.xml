<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Batch &amp; Scheduler Manager</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage, lightning__HomePage, lightning__RecordPage">
            <property name="cardTitle" type="String" label="Card title" default="Birthday Newsletter Management" />
            <property name="batchClassName" type="String" label="Batch Class name" default="ContactBirthdayBatch" />
            <property name="schedulerClassName" type="String" label="Scheduler Class name" default="ContactBirthdayScheduler" />
            <property name="jobName" type="String" label="Task name in the scheduler" default="Daily Birthday Congratulations" />
            <property name="cronExpression" type="String" label="CRON expression" default="0 0 9 * * ?" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>